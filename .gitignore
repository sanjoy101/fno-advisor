# ---- Secrets: never commit ----------------------------------------------------
.env
.env.*
!.env.example
*.token
*token*.json
.fyers_token.json

# ---- Data: local-only, regenerable, and potentially large ----------------------
# data/* rather than data/ so the placeholder survives and the tree shape is kept.
data/*
!data/.gitkeep
!data/README.md
*.parquet
*.duckdb
*.duckdb.wal
*.csv
!tests/**/*.csv

# ---- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Test / tooling caches ----------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ---- Frontend -----------------------------------------------------------------
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*

# ---- Editors / OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
